# Copy to .env for Docker Compose. Generate distinct strong random values for secrets.
INTERNAL_API_KEY=replace-with-one-shared-random-internal-key-at-least-32-characters
GATEWAY_INTERNAL_KEY=replace-with-one-shared-random-gateway-key-at-least-32-characters
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
# Optional OTLP/HTTP collector endpoint, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
