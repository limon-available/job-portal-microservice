NODE_ENV=development
# Docker Compose replaces localhost Kafka, Redis, Auth, and Job addresses with container DNS.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
PORT=5004
DB_URL=postgresql://user:password@your-neon-host/applications?sslmode=require
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092
GATEWAY_INTERNAL_KEY=replace-with-the-same-random-gateway-key-used-by-the-gateway
JOB_SERVICE_URL=http://localhost:5003
AUTH_SERVICE_URL=http://localhost:5000
INTERNAL_API_KEY=replace-with-the-same-random-internal-key-used-by-auth-job-and-utils
