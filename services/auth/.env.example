NODE_ENV=development
# Docker Compose replaces localhost Kafka, Redis, and upload-service addresses with container DNS.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
PORT=5000
DB_URL=postgresql://user:password@host/database?sslmode=require
RESET_JWT_SEC=replace-with-a-different-random-secret-at-least-32-characters
REFRESH_JWT_SEC=replace-with-another-random-secret-at-least-32-characters
EMAIL_VERIFY_JWT_SEC=replace-with-a-separate-random-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379
JWT_SEC=replace-with-a-random-secret-at-least-32-characters
KAFKA_BROKER=localhost:9092
UPLOAD_SERVICE=http://localhost:5001
INTERNAL_API_KEY=replace-with-a-random-internal-service-key-at-least-32-characters
GATEWAY_INTERNAL_KEY=replace-with-the-same-random-gateway-key-used-by-the-gateway
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
