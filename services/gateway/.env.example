NODE_ENV=development
# Docker Compose supplies service URLs and shared keys from the root .env file.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
PORT=8080
JWT_SEC=replace-with-the-auth-service-access-token-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379
GATEWAY_INTERNAL_KEY=replace-with-the-same-random-gateway-key-used-by-services
INTERNAL_API_KEY=replace-with-the-same-random-internal-key-used-by-services
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
PROXY_TIMEOUT_MS=8000
CIRCUIT_RESET_MS=30000
AUTH_SERVICE_URL=http://localhost:5000
USER_SERVICE_URL=http://localhost:5002
JOB_SERVICE_URL=http://localhost:5003
APPLICATION_SERVICE_URL=http://localhost:5004
NOTIFICATION_SERVICE_URL=http://localhost:5005
UTILS_SERVICE_URL=http://localhost:5001
