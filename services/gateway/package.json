    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "@types/opossum": "^8.1.9",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.1",
