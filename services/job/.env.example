NODE_ENV=development
# Docker Compose replaces localhost Kafka, Redis, and upload-service addresses with container DNS.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
PORT=5003
DB_URL=postgresql://user:password@your-neon-host/jobs?sslmode=require
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092
GATEWAY_INTERNAL_KEY=replace-with-the-same-random-gateway-key-used-by-the-gateway
UPLOAD_SERVICE=http://localhost:5001
INTERNAL_API_KEY=replace-with-the-same-random-internal-key-used-by-auth-and-utils
