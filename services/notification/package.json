{
  "name": "@hireheaven/notification",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "start": "node dist/index.js",
    "dev": "node scripts/copy-templates.mjs && concurrently \"tsc -w\" \"nodemon dist/index.js\"",
    "lint": "eslint src migrations scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down"
  },
  "dependencies": {
    "@hireheaven/shared": "1.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "node-pg-migrate": "^7.9.1",
    "nodemailer": "^7.0.3",
    "pg": "^8.16.0",
    "redis": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
