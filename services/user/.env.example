NODE_ENV=development
# Docker Compose replaces the localhost upload-service address with container DNS.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
PORT=5002
DB_URL=postgresql://user:password@your-neon-host/user?sslmode=require
GATEWAY_INTERNAL_KEY=replace-with-the-same-random-gateway-key-used-by-the-gateway
UPLOAD_SERVICE=http://localhost:5001
INTERNAL_API_KEY=replace-with-the-same-random-internal-key-used-by-auth-and-utils
